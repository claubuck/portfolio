---
import { experiencia, formacion } from '../data/perfil';
import Icono from './Icono.astro';
---

<div class="space-y-10">
  <ol class="relative space-y-10 border-l border-line pl-7">
    {
      experiencia.map((puesto) => (
        <li class="relative">
          <span
            aria-hidden="true"
            class="absolute -left-[33px] top-1.5 grid h-3 w-3 place-items-center rounded-full border-2 border-bg bg-accent"
          />
          <p class="font-mono text-xs text-muted">{puesto.periodo}</p>
          <h3 class="mt-1.5 text-lg font-semibold tracking-tight">{puesto.puesto}</h3>
          <p class="font-medium text-accent-text">{puesto.empresa}</p>

          {puesto.contexto && (
            <p class="mt-2 text-sm leading-relaxed text-muted italic">{puesto.contexto}</p>
          )}

          <ul class="mt-3.5 space-y-2">
            {puesto.logros.map((logro) => (
              <li class="relative pl-4 leading-relaxed text-muted">
                <span
                  aria-hidden="true"
                  class="absolute left-0 top-[0.65em] h-[5px] w-[5px] rounded-full bg-accent"
                />
                {logro}
              </li>
            ))}
          </ul>

          {puesto.enlaces.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {puesto.enlaces.map((enlace) => (
                <a
                  href={enlace.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
                >
                  <Icono nombre="externo" class="h-3 w-3" />
                  {enlace.texto}
                </a>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>

  {
    formacion.length > 0 && (
      <div class="rounded-xl border border-line bg-surface p-6">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">Formación</h3>
        <ul class="mt-4 space-y-3">
          {formacion.map((f) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span>
                <span class="font-medium">{f.titulo}</span>
                <span class="text-muted"> · {f.institucion}</span>
              </span>
              <span class="shrink-0 font-mono text-xs text-muted">{f.periodo}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
