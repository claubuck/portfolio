---
import { render } from 'astro:content';
import Icono from './Icono.astro';

interface Props {
  proyecto: any;
  compacto?: boolean;
}
const { proyecto, compacto = false } = Astro.props;
const datos = proyecto.data;

// Solo renderizamos el cuerpo del Markdown en las tarjetas grandes.
const { Content } = compacto ? { Content: null } : await render(proyecto);

const enlaces = [
  { url: datos.repo, texto: 'Código', icono: 'github' },
  { url: datos.demo, texto: 'Ver sitio', icono: 'externo' },
].filter((e) => e.url);
---

<article
  class:list={[
    'group relative flex flex-col rounded-xl border bg-surface p-6 transition-colors hover:border-accent/60 sm:p-7',
    datos.destacado ? 'border-accent/35' : 'border-line',
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold tracking-tight sm:text-xl">{datos.titulo}</h3>
      {
        (datos.rol || datos.periodo) && (
          <p class="mt-1 font-mono text-xs text-muted">
            {[datos.rol, datos.periodo].filter(Boolean).join(' · ')}
          </p>
        )
      }
    </div>

    {
      datos.destacado && (
        <span class="shrink-0 rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-medium text-accent-text">
          Destacado
        </span>
      )
    }
  </div>

  <p class="mt-3.5 leading-relaxed text-muted">{datos.resumen}</p>

  {Content && <div class="prosa mt-4 text-[15px]"><Content /></div>}

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      datos.stack.map((tec: string) => (
        <li class="rounded-md border border-line bg-bg px-2.5 py-1 font-mono text-xs text-muted">
          {tec}
        </li>
      ))
    }
  </ul>

  {
    enlaces.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-line pt-5">
        {enlaces.map((enlace) => (
          <a
            href={enlace.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-text transition-opacity hover:opacity-75"
          >
            <Icono nombre={enlace.icono} class="h-4 w-4" />
            {enlace.texto}
          </a>
        ))}
      </div>
    )
  }
</article>
