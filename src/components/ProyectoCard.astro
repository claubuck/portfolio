---
import { render } from 'astro:content';
import Icono from './Icono.astro';

interface Props {
  proyecto: any;
  compacto?: boolean;
  indice?: number;
}
const { proyecto, compacto = false, indice = 0 } = Astro.props;
const datos = proyecto.data;

// Solo renderizamos el cuerpo del Markdown en las tarjetas grandes.
const { Content } = compacto ? { Content: null } : await render(proyecto);

const enlaces = [
  { url: datos.repo, texto: 'Código', icono: 'github' },
  { url: datos.demo, texto: 'Ver sitio', icono: 'externo' },
].filter((e) => e.url);

const numero = String(indice + 1).padStart(2, '0');
---

<article
  class:list={[
    'revelar foco group relative flex flex-col overflow-hidden rounded-2xl border border-linea bg-superficie transition-all duration-500 hover:-translate-y-1 hover:border-linea-fuerte',
    compacto ? 'p-6' : 'borde-degradado p-7 sm:p-9',
  ]}
  style={`--retraso: ${Math.min(indice * 70, 280)}ms`}
>
  <!-- Resplandor de esquina en los destacados -->
  {
    !compacto && (
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-16 h-56 w-56 rounded-full opacity-0 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
        style="background: var(--c-acento);"
      />
    )
  }

  <div class="relative flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-xs text-acento-texto/70">{numero}</span>
        {
          datos.destacado && (
            <span class="rounded-full border border-acento/30 bg-acento-tenue px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-acento-texto uppercase">
              Destacado
            </span>
          )
        }
      </div>

      <h3
        class:list={[
          'mt-2.5 font-display font-bold tracking-tight transition-colors duration-300 group-hover:text-acento-texto',
          compacto ? 'text-lg' : 'text-xl sm:text-2xl',
        ]}
      >
        {datos.titulo}
      </h3>

      {
        (datos.rol || datos.periodo) && (
          <p class="mt-1.5 font-mono text-xs text-suave">
            {[datos.rol, datos.periodo].filter(Boolean).join(' · ')}
          </p>
        )
      }
    </div>
  </div>

  <p class="relative mt-4 leading-relaxed text-suave">{datos.resumen}</p>

  {Content && <div class="prosa relative mt-5 text-[15px]"><Content /></div>}

  <ul class="relative mt-6 flex flex-wrap gap-1.5">
    {
      datos.stack.map((tec: string) => (
        <li class="rounded-lg border border-linea bg-bg px-2.5 py-1 font-mono text-xs text-suave transition-colors duration-300 group-hover:border-linea-fuerte">
          {tec}
        </li>
      ))
    }
  </ul>

  {
    enlaces.length > 0 && (
      <div class="relative mt-6 flex flex-wrap items-center gap-5 border-t border-linea pt-5">
        {enlaces.map((enlace) => (
          <a
            href={enlace.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group/enlace inline-flex items-center gap-1.5 text-sm font-medium text-acento-texto transition-opacity hover:opacity-75"
          >
            <Icono nombre={enlace.icono} class="h-4 w-4" />
            {enlace.texto}
            <Icono
              nombre="flecha"
              class="h-3.5 w-3.5 -translate-x-1 opacity-0 transition-all duration-300 group-hover/enlace:translate-x-0 group-hover/enlace:opacity-100"
            />
          </a>
        ))}
      </div>
    )
  }
</article>
