---
import { perfil } from '../data/perfil';
import Icono from './Icono.astro';

const anio = new Date().getFullYear();
const redes = [
  { nombre: 'linkedin', url: perfil.redes.linkedin, etiqueta: 'LinkedIn' },
  { nombre: 'github', url: perfil.redes.github, etiqueta: 'GitHub' },
  {
    nombre: 'whatsapp',
    url: perfil.whatsapp ? `https://wa.me/${perfil.whatsapp}` : '',
    etiqueta: 'WhatsApp',
  },
  { nombre: 'mail', url: `mailto:${perfil.email}`, etiqueta: 'Email' },
].filter((r) => r.url);
---

<footer class="relative mt-8 border-t border-linea">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-5 py-10 sm:flex-row"
  >
    <div class="text-center sm:text-left">
      <p class="font-display text-sm font-semibold tracking-tight">{perfil.nombre}</p>
      <p class="mt-1 text-sm text-suave">
        © {anio} · Hecho con <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-acento-texto transition-opacity hover:opacity-75">Astro</a
        > y Tailwind
      </p>
    </div>

    <div class="flex items-center gap-1">
      {
        redes.map((red) => (
          <a
            href={red.url}
            target={red.url.startsWith('mailto:') ? undefined : '_blank'}
            rel="noopener noreferrer"
            aria-label={red.etiqueta}
            class="grid h-11 w-11 place-items-center rounded-xl border border-transparent text-suave transition-all duration-300 hover:-translate-y-0.5 hover:border-linea hover:bg-superficie hover:text-tinta"
          >
            <Icono nombre={red.nombre} class="h-[18px] w-[18px]" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Volver arriba -->
  <a
    href="#inicio"
    class="group absolute -top-5 right-5 grid h-10 w-10 place-items-center rounded-xl border border-linea bg-superficie text-suave transition-all duration-300 hover:-translate-y-0.5 hover:border-acento hover:text-acento-texto sm:right-8"
    aria-label="Volver arriba"
  >
    <Icono
      nombre="flecha"
      class="h-4 w-4 -rotate-90 transition-transform duration-300 group-hover:-translate-y-0.5"
    />
  </a>
</footer>
