---
import Icono from './Icono.astro';
---

<button
  id="btn-tema"
  type="button"
  class="group grid h-9 w-9 place-items-center rounded-lg border border-linea text-suave transition-all duration-300 hover:border-acento hover:text-acento-texto"
  aria-label="Cambiar entre tema claro y oscuro"
>
  <span class="relative block h-[18px] w-[18px]">
    <Icono
      nombre="sol"
      class="absolute inset-0 h-[18px] w-[18px] rotate-90 scale-0 opacity-0 transition-all duration-500 dark:rotate-0 dark:scale-100 dark:opacity-100"
    />
    <Icono
      nombre="luna"
      class="absolute inset-0 h-[18px] w-[18px] rotate-0 scale-100 opacity-100 transition-all duration-500 dark:-rotate-90 dark:scale-0 dark:opacity-0"
    />
  </span>
</button>

<script>
  const boton = document.getElementById('btn-tema');
  boton?.addEventListener('click', () => {
    const raiz = document.documentElement;
    const nuevo = raiz.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    raiz.setAttribute('data-theme', nuevo);
    try {
      localStorage.setItem('tema', nuevo);
    } catch {
      /* si localStorage está bloqueado, el tema dura solo esta visita */
    }
  });
</script>
