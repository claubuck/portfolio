---
import { stack } from '../data/perfil';
import Icono from './Icono.astro';

const iconos: Record<string, string> = {
  'Inteligencia Artificial': 'ia',
  Automatización: 'automatizacion',
  Backend: 'servidor',
  Frontend: 'codigo',
  Datos: 'datos',
  Infraestructura: 'capas',
};
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    stack.map((grupo, i) => (
      <div
        class:list={[
          'revelar foco group rounded-2xl border border-linea bg-superficie p-6 transition-all duration-500 hover:-translate-y-1 hover:border-linea-fuerte',
          // La primera categoría (IA) ocupa el ancho completo: es
          // lo que lo diferencia del resto de perfiles backend.
          i === 0 ? 'borde-degradado sm:col-span-2' : '',
        ]}
        style={`--retraso: ${Math.min(i * 70, 280)}ms`}
      >
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-linea bg-bg text-acento-texto transition-transform duration-500 group-hover:scale-110">
            <Icono nombre={iconos[grupo.categoria] ?? 'codigo'} class="h-5 w-5" />
          </span>
          <h3 class="font-display text-base font-semibold tracking-tight">{grupo.categoria}</h3>
        </div>

        <ul class="mt-5 flex flex-wrap gap-2">
          {grupo.items.map((item) => (
            <li class="rounded-lg border border-linea bg-bg px-3 py-1.5 font-mono text-xs text-suave transition-colors duration-300 hover:border-acento hover:text-acento-texto">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
