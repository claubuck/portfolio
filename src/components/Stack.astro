---
import { stack } from '../data/perfil';
import Icono from './Icono.astro';

const iconos: Record<string, string> = {
  'Inteligencia Artificial': 'ia',
  Automatización: 'automatizacion',
  Backend: 'servidor',
  Frontend: 'codigo',
  Datos: 'datos',
  Infraestructura: 'capas',
};
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    stack.map((grupo) => (
      <div class="rounded-xl border border-line bg-surface p-6">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent-soft text-accent-text">
            <Icono nombre={iconos[grupo.categoria] ?? 'codigo'} class="h-[18px] w-[18px]" />
          </span>
          <h3 class="font-semibold">{grupo.categoria}</h3>
        </div>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {grupo.items.map((item) => (
            <li class="rounded-md border border-line bg-bg px-2.5 py-1 font-mono text-xs text-muted">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
