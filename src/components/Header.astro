---
import { navegacion, perfil } from '../data/perfil';
import CambiarTema from './CambiarTema.astro';
import Icono from './Icono.astro';

const iniciales = perfil.nombre
  .split(' ')
  .map((p) => p[0])
  .join('')
  .slice(0, 2);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5">
    <a href="#inicio" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-[13px] font-bold text-white"
        >{iniciales}</span
      >
      <span class="hidden text-sm sm:block">{perfil.nombre}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        navegacion.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface hover:text-ink"
          >
            {item.texto}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <CambiarTema />
      <button
        id="btn-menu"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-lg border border-line text-muted md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <Icono nombre="menu" class="h-[18px] w-[18px]" />
      </button>
      <a
        href={`mailto:${perfil.email}`}
        class="hidden rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90 md:block"
      >
        Contáctame
      </a>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-line bg-bg md:hidden">
    <nav class="mx-auto flex max-w-5xl flex-col px-5 py-2" aria-label="Navegación móvil">
      {
        navegacion.map((item) => (
          <a href={item.href} class="rounded-lg px-2 py-3 text-sm text-muted hover:text-ink">
            {item.texto}
          </a>
        ))
      }
      <a
        href={`mailto:${perfil.email}`}
        class="my-2 rounded-lg bg-accent px-4 py-2.5 text-center text-sm font-medium text-white"
      >
        Contáctame
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-movil');

  btn?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(abierto));
    btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });

  // Cierra el menú al tocar un enlace, si no tapa la sección de destino.
  menu?.querySelectorAll('a').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
