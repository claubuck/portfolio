---
import { navegacion, perfil } from '../data/perfil';
import CambiarTema from './CambiarTema.astro';
import Icono from './Icono.astro';

const iniciales = perfil.nombre
  .split(' ')
  .map((p) => p[0])
  .join('')
  .slice(0, 2);
---

<header
  id="cabecera"
  class="sticky top-0 z-40 border-b border-transparent transition-all duration-300"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:h-18">
    <a href="#inicio" class="group flex items-center gap-2.5" aria-label="Volver al inicio">
      <span
        class="grid h-9 w-9 place-items-center rounded-xl fondo-degradado font-display text-[13px] font-bold text-white transition-transform duration-300 group-hover:scale-105"
        >{iniciales}</span
      >
      <span class="hidden font-display text-sm font-semibold tracking-tight sm:block">
        {perfil.nombre}
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Navegación principal">
      {
        navegacion.map((item) => (
          <a
            href={item.href}
            data-nav
            class="group relative rounded-lg px-3.5 py-2 text-sm text-suave transition-colors duration-200 hover:text-tinta data-[activo]:text-tinta"
          >
            {item.texto}
            <span
              aria-hidden="true"
              class="absolute inset-x-3.5 -bottom-0.5 h-px scale-x-0 fondo-degradado transition-transform duration-300 group-data-[activo]:scale-x-100"
            />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <CambiarTema />
      <button
        id="btn-menu"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-lg border border-linea text-suave transition-colors hover:text-tinta md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <Icono nombre="menu" class="h-[18px] w-[18px]" />
      </button>
      <a
        href="#contacto"
        class="hidden rounded-lg border border-linea bg-superficie px-4 py-2 text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 hover:border-acento hover:text-acento-texto md:block"
      >
        Contáctame
      </a>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-linea bg-bg/95 backdrop-blur-xl md:hidden">
    <nav class="mx-auto flex max-w-5xl flex-col px-5 py-2" aria-label="Navegación móvil">
      {
        navegacion.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-2 py-3.5 text-sm text-suave transition-colors hover:text-tinta"
          >
            {item.texto}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="my-2 rounded-lg fondo-degradado px-4 py-3 text-center text-sm font-semibold text-white"
      >
        Contáctame
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('btn-menu');
  const menu = document.getElementById('menu-movil');
  const cabecera = document.getElementById('cabecera');

  btn?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(abierto));
    btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });

  // Cierra el menú al tocar un enlace, si no tapa la sección de destino.
  menu?.querySelectorAll('a').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // El fondo del header aparece recién al hacer scroll: arriba
  // del todo, el hero se ve limpio y sin línea divisoria.
  const alternarFondo = () => {
    const bajado = window.scrollY > 24;
    cabecera?.classList.toggle('border-linea', bajado);
    cabecera?.classList.toggle('bg-bg/80', bajado);
    cabecera?.classList.toggle('backdrop-blur-xl', bajado);
  };

  alternarFondo();
  window.addEventListener('scroll', alternarFondo, { passive: true });
</script>
