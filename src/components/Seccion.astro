---
interface Props {
  id: string;
  numero: string;
  titulo: string;
  descripcion?: string;
  class?: string;
}
const { id, numero, titulo, descripcion, class: clase = '' } = Astro.props;
---

<section id={id} class={`mx-auto max-w-5xl px-5 py-20 sm:py-28 ${clase}`}>
  <div class="revelar mb-12">
    <!-- Numeración tipo índice: ordena la lectura y da carácter. -->
    <div class="flex items-center gap-3">
      <span class="font-mono text-xs font-medium tracking-[0.2em] text-acento-texto">
        {numero}
      </span>
      <span aria-hidden="true" class="h-px w-10 fondo-degradado opacity-60"></span>
    </div>

    <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      {titulo}
    </h2>

    {
      descripcion && (
        <p class="mt-3 max-w-2xl leading-relaxed text-suave">{descripcion}</p>
      )
    }
  </div>

  <slot />
</section>
