---
interface Props {
  id: string;
  titulo: string;
  descripcion?: string;
  class?: string;
}
const { id, titulo, descripcion, class: clase = '' } = Astro.props;
---

<section id={id} class={`mx-auto max-w-5xl px-5 py-16 sm:py-20 ${clase}`}>
  <div class="mb-10">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{titulo}</h2>
    {descripcion && <p class="mt-2.5 max-w-2xl text-muted">{descripcion}</p>}
  </div>
  <slot />
</section>
