---
import '../styles/global.css';
import { perfil } from '../data/perfil';
import { ruta } from '../utils/ruta';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = `${perfil.nombre} — ${perfil.rol}`,
  descripcion = perfil.titular,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={perfil.nombre} />
    <link rel="canonical" href={urlCanonica} />

    <!-- Cómo se ve el link al compartirlo en LinkedIn o WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={ruta('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Aplica el tema guardado antes de pintar, para que no haya
         un parpadeo blanco al cargar en modo oscuro. -->
    <script is:inline>
      (function () {
        try {
          var guardado = localStorage.getItem('tema');
          if (guardado === 'light' || guardado === 'dark') {
            document.documentElement.setAttribute('data-theme', guardado);
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          /* localStorage bloqueado: se queda con el tema oscuro por defecto */
        }
      })();
    </script>
  </head>

  <body class="font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
